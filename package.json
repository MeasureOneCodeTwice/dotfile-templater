{
  "name": "dotfile-templater",
  "version": "1.0.0",
  "description": "A simple templater intender for use with dotfiles",
  "kind": "module",
  "moduleResolution": "nodenext",
  "main": "src/index.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild --bundle --platform=node --outfile=./dist/index.js ./src",
    "start": "node dist/index.js",
    "format": "prettier --write .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeasureOneCodeTwice/dotfile-templater.git"
  },
  "keywords": [
    "template"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MeasureOneCodeTwice/dotfile-templater/issues"
  },
  "homepage": "https://github.com/MeasureOneCodeTwice/dotfile-templater#readme",
  "dependencies": {
    "@types/command-line-args": "^5.2.3",
    "command-line-args": "^6.0.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.9.6"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
