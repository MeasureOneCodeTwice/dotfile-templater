{
  "name": "dotfile-templater",
  "version": "1.0.0",
  "description": "A simple templater intender for use with dotfiles",
  "main": "src/index.js",
  "scripts": {
    "build": "npx tsc --noEmit && npx esbuild --bundle --platform=node ./src > bundle.js",
    "start": "node bundle.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
