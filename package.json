  "bugs": {
    "url": "https://github.com/MeasureOneCodeTwice/dotfile-templater/issues"
  },
  "homepage": "https://github.com/MeasureOneCodeTwice/dotfile-templater#readme",
  "dependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
